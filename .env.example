# ─── Embedding backend ──────────────────────────────────────────────
# "huggingface" (best quality, needs torch+sentence-transformers)
# "openai"      (hosted, requires OPENAI_API_KEY)
# "hashing"     (fallback, sklearn HashingVectorizer, no PyTorch needed)
# If "huggingface" fails to import (torch/transformers mismatch) the
# system automatically falls back to "hashing" so the demo keeps running.
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Generation backend ─────────────────────────────────────────────
# "extractive"  (default, no LLM, returns top-ranked chunk verbatim)
# "openai"      (uses OPENAI_CHAT_MODEL + OPENAI_API_KEY below)
LLM_BACKEND=extractive
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ─── Chunking ───────────────────────────────────────────────────────
# CHUNK_UNIT=chars (default) uses character counts.
# CHUNK_UNIT=tokens uses tiktoken (cl100k_base by default) so chunk_size
# matches what the LLM actually sees — recommended when LLM_BACKEND=openai.
CHUNK_SIZE=500
CHUNK_OVERLAP=100
CHUNK_UNIT=chars
TIKTOKEN_ENCODING=cl100k_base

# ─── Retrieval ──────────────────────────────────────────────────────
TOP_K=4
SCORE_THRESHOLD=0.30
CONFIDENCE_THRESHOLD=0.45
GROUNDING_MIN_COVERAGE=0.35
PROMPT_STRATEGY=strict

# Hybrid retrieval: "dense" = FAISS only, "hybrid" = FAISS + BM25 fused via RRF.
# Hybrid is recommended — it catches lexical queries (names, IDs, acronyms)
# that dense embeddings often miss.
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATE_MULTIPLIER=3
RRF_K=60

# Diversify the top-k with Maximal Marginal Relevance to avoid surfacing
# near-duplicate chunks when CHUNK_OVERLAP is high.
MMR_ENABLED=true
MMR_LAMBDA=0.6

# Optional cross-encoder reranker. Adds latency and a model download on
# first use, but is the single biggest precision win when enabled.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_MULTIPLIER=4

# Query result cache (in-memory LRU). Invalidates automatically on ingest/delete.
QUERY_CACHE_ENABLED=true
QUERY_CACHE_SIZE=256

# ─── PDF extraction ─────────────────────────────────────────────────
# "auto" prefers PyMuPDF (fitz) for better layout handling, falls back to pypdf.
PDF_BACKEND=auto

# ─── Rate limiting ──────────────────────────────────────────────────
# Per-IP token bucket on POST /query, /ingest, /evaluate. 0 disables.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_BURST=20

# ─── Storage ────────────────────────────────────────────────────────
INDEX_DIR=storage/faiss_index
LOG_DIR=storage/logs
EVAL_DIR=storage/eval_results
EVAL_DB_PATH=storage/eval_results/evaluations.sqlite3

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. "*" allows any origin (dev
# default). In production, restrict to your real frontend host(s):
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ─── Demo behaviour ─────────────────────────────────────────────────
# Auto-ingest the bundled example dataset on first startup so the
# dashboard works out of the box. Set false in production.
AUTO_INGEST_ON_STARTUP=true
AUTO_INGEST_PATH=data/docs

# Optional API protection. Leave blank for local/demo use. When set,
# POST /ingest, POST /ingest/upload, POST /query, POST /evaluate, and
# DELETE /documents require an X-API-Key header with this value.
API_KEY=

# Logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
